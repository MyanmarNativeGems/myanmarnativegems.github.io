# Copy this file to .env.local for local development:
#   cp env.example .env.local
#
# Public CSV endpoint of the Myanmar Native Gems inventory Google Sheet.
# This URL is intentionally public: the Sheet is the public product catalog.
# Anything prefixed with VITE_ is embedded in the frontend bundle and is public.
# Never put secrets, customer data, or private business data in VITE_ variables
# or in the published Sheet.
VITE_GEMS_SHEET_URL=https://docs.google.com/spreadsheets/d/15ecCh3G3JogHYwb_rLZlWEFrB3Z3fOH1G5-b7GlFEhQ/gviz/tq?tqx=out:csv&gid=0

# Google Apps Script Web App endpoint that appends Contact-page inquiries
# as rows in this Google Sheet:
#   https://docs.google.com/spreadsheets/d/1PZNkqc-qDf2PrdA5sHi-aRXEpGlmrkBRvqvUPccDn2s/edit
# This is NOT the Sheet's own URL: Sheets has no public endpoint that can
# accept a write from the browser, so a small Apps Script Web App acts as
# the mailbox in between. Deploy scripts/google-apps-script/inquiry-to-sheet.gs
# (see that file's header for exact steps) and paste the resulting /exec
# URL here. Leave blank to keep the safe mailto fallback: the form still
# works, it just opens a prefilled draft in the visitor's email app instead
# of submitting silently.
VITE_INQUIRY_ENDPOINT_URL=https://script.google.com/macros/s/AKfycbzawsLUwZcnlbQg1Q8pkoiMTFheETHyGp-KrVUUjlmZ3if9OUNBSbtvWAgvxIns-Jd5/exec

# Google Analytics 4 Measurement ID (see README.md "Google Analytics").
# A measurement ID is not a secret -- it's meant to be embedded in public
# frontend code -- so it's fine to leave set here. Leave blank to disable
# analytics entirely (src/lib/analytics.ts no-ops without it).
VITE_GA_MEASUREMENT_ID=G-PYQF1MZXXF

# Set to "true" to initialize GA4 in debug mode (visible in GA's
# DebugView) during local development. Optional; defaults to off.
VITE_GA_DEBUG=false
