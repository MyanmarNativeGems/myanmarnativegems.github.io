# Copy this file to .env.local for local development:
#   cp env.example .env.local
#
# Public CSV endpoint of the Burma Gems inventory Google Sheet.
# This URL is intentionally public: the Sheet is the public product catalog.
# Anything prefixed with VITE_ is embedded in the frontend bundle and is public.
# Never put secrets, customer data, or private business data in VITE_ variables
# or in the published Sheet.
VITE_GEMS_SHEET_URL=https://docs.google.com/spreadsheets/d/15ecCh3G3JogHYwb_rLZlWEFrB3Z3fOH1G5-b7GlFEhQ/gviz/tq?tqx=out:csv&gid=0
